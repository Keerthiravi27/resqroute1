# Copy this file to ".env" (same folder) and edit it. Never commit ".env".
# Without a ".env" file everything still works, except automatic translation.

PORT=5000
MAX_AUDIO_MB=15

# Only needed if you serve the pages from a different origin (e.g. VS Code Live Server
# on port 5500). Leave empty when you open http://localhost:5000 (recommended).
# CORS_ORIGIN=http://127.0.0.1:5500

# ---------------------------------------------------------------
# TRANSLATION (Tamil <-> English). Choose ONE provider.
#   none          -> translation off; staff type the translation manually (default)
#   mymemory      -> free public service, no key, small daily limit,
#                    max ~450 characters per request.
#                    PRIVACY: the transcript TEXT is sent to a third party.
#   libretranslate-> your own LibreTranslate server (text stays on your machine)
#   google        -> Google Cloud Translation (needs a billing-enabled API key)
# Audio is never sent to any translation service. (Browser speech recognition
# is separate: Chrome/Edge may send microphone audio to the browser vendor.)
# ---------------------------------------------------------------
TRANSLATION_PROVIDER=none

# MyMemory: optional email raises the free daily limit
# MYMEMORY_EMAIL=you@example.com

# LibreTranslate
# LIBRETRANSLATE_URL=http://localhost:5001
# LIBRETRANSLATE_API_KEY=

# Google Cloud Translation
# GOOGLE_TRANSLATE_API_KEY=
